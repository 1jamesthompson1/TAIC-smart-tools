# ==================================================
# TAIC Smart Assistant Environment Configuration
# ==================================================
# Copy this file to .env and fill in your actual values
# This file contains all environment variables needed for the application

# Items you need to configure:
# - Azure OpenAI and Azure AI endpoints (managed identity in production)
# - Azure Storage account name (managed identity in production)
# - Azure AD OAuth credentials (Client ID, Client Secret, Tenant ID)

# ==================================================
# Development settings — LOCAL ONLY
# ==================================================
# DEV=true is the single development switch. It shows a DEV banner in the UI
# and allows NO_LOGIN and NO_LOGS. NEVER set DEV=true in production.
DEV=true
NO_LOGS=true # Skip writing conversation/search logs (requires DEV=true)
NO_LOGIN=true # Disable login and use DEV_USERNAME (requires DEV=true)

# ==================================================
# LLM Provider Configuration
# ==================================================
# Required: model (or Azure OpenAI deployment name) used for all assistant requests.
# Authentication uses the same Microsoft Entra identity as the rest of the app.
# Locally, `az login` supplies the identity. Assign that identity
# "Cognitive Services OpenAI User" on the Azure OpenAI / AI Services resource.
# The endpoint must include /openai/v1/, for example:
# https://<resource>.openai.azure.com/openai/v1/
OPENAI_MODEL=gpt-6-luna
AZURE_OPENAI_ENDPOINT=endpoint_here

# ==================================================
# Vector Database Configuration
# ==================================================
# Path to the vector database (local directory)
VECTORDB_PATH=vectordb
VECTORDB_TABLE_NAME=all_document_types

# Embeddings use the same Azure OpenAI endpoint and managed identity above.

# ==================================================
# Azure Storage Configuration
# ==================================================
# Azure Storage Account for conversation and search logs.
# Authentication is Microsoft Entra / managed identity only. There is no
# shared-key or connection-string option.
#   - assign the service identity only the containers/tables it needs:
#       Storage Blob Data Contributor  -> each blob container (container scope)
#       Storage Table Data Contributor -> each table (table scope)
#       Storage Blob Data Reader       -> vectordb (startup download only)
#   - locally, run `az login` so DefaultAzureCredential can use your CLI identity
#   - in production, use a system-assigned managed identity
#   - for dev/beta, attach the user-assigned test identity and set
#     AZURE_CLIENT_ID to its client ID
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name

# Azure Table Storage - table names for metadata
CONVERSATION_METADATA_TABLE_NAME=smartassistantconversationsmetadata
KNOWLEDGE_SEARCH_LOGS_TABLE_NAME=knowledgesearches

# Azure Blob Storage - container names for data storage
CONVERSATION_CONTAINER_NAME=smartassistantconversations
KNOWLEDGE_SEARCH_CONTAINER_NAME=knowledgesearchresults

# ==================================================
# Azure AD OAuth Configuration
# ==================================================
# Azure AD app registration credentials for user authentication
CLIENT_ID=your_azure_ad_client_id
CLIENT_SECRET=your_azure_ad_client_secret
TENANT_ID=your_azure_ad_tenant_id


